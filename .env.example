# Kopieer dit bestand naar .env en vul één blok in. Commit .env nooit.

# --- Blok 1: OpenClaw-gateway op de VPS (standaard) ---
# Privé: alleen bereikbaar op 127.0.0.1 van de VPS. Modellen via Nathans OpenAI-OAuth in OpenClaw.
# MODEL_* is een OpenClaw-agent (openclaw/<agentId>), geen kale modelnaam: zie instructions.md.
OPENAI_BASE_URL=http://127.0.0.1:18789/v1
OPENAI_API_KEY=<OpenClaw gateway-token (Nathan vult in)>
MODEL_KLEIN=openclaw/htf-raadslid
MODEL_GROOT=openclaw/htf-koning
# python = Python voert de MCP-toolcalls zelf uit (nodig: de gateway geeft geen function calling door).
TOOLMODUS=python

# --- Blok 1b: Roboest-endpoint (back-up) ---
# OPENAI_BASE_URL=https://roboest.findingsolutions.be/v1
# OPENAI_API_KEY=<teamkey van je Teamkaartje>
# MODEL_KLEIN=achrona
# MODEL_GROOT=achrona-groot
# TOOLMODUS=native

# --- Blok 2: FreeLLMAPI op je eigen laptop (optioneel, gratis) ---
# Budget op, of wil je zelf modellen kiezen? Zie "FreeLLMAPI (optioneel)" in de README.
# OPENAI_BASE_URL=http://localhost:3001/v1
# OPENAI_API_KEY=<unified-key>
# MODEL_KLEIN=auto:fast
# MODEL_GROOT=auto:smartest

# --- Blok 3: Ollama lokaal (eigen model, zonder support) ---
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
# MODEL_KLEIN=qwen3:8b
# MODEL_GROOT=qwen3:8b

# --- Kennisbronnen ---
# MCP-pad per Raadslid: MCP_<ROL>=https://<mcp-host>/<rol>/mcp (de link krijg je om 10:00).
# Leeg = fallback: de bestanden in kennisbronnen/<rol>/ gaan in de prompt.
MCP_ARCHMAGE=https://mcp.findingsolutions.be/archmage/mcp
MCP_BEAST_MASTER=https://mcp.findingsolutions.be/beast_master/mcp
MCP_ENGINEER=https://mcp.findingsolutions.be/engineer/mcp
MCP_GUARDIAN_KEEPER=https://mcp.findingsolutions.be/guardian_keeper/mcp
MCP_HISTORIAN=https://mcp.findingsolutions.be/historian/mcp
MCP_ORACLE=https://mcp.findingsolutions.be/oracle/mcp

# REASONING (minimal|low|medium|high) werkt alleen bij redeneermodellen; weglaten = standaard van het model.

# Aantal rondes van de vaste volgorde in kies_volgende() (standaard 2).
# Het Beurtenbudget (maximaal 10 Raadslid-beurten per run) geldt altijd.
RONDES=2

# Uitvoermap voor trace.json + verdict.json. Leeg = repo-root (wat de publieke viewer toont).
# Proefruns: COUNCIL_OUTPUT_DIR=runs/proef  (bekijken: VIEWER_PORT=8101 uv run viewer runs/proef)
COUNCIL_OUTPUT_DIR=
